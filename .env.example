# ============================================================
# GREEN PARK SCHOOL - ENVIRONMENT CONFIGURATION
# ============================================================

# Environment Mode: 'local' (offline-capable school server) or 'cloud' (Render/Vercel hosted)
APP_ENV=local
VITE_APP_ENV=local

# Local School Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=greenpark_db
LOCAL_DATABASE_PORT=5434
DATABASE_URL=postgresql://postgres:postgres@db:5432/greenpark_db

# Online Neon PostgreSQL Database (For Two-Way Cloud Sync)
NEON_DATABASE_URL=postgresql://neondb_owner:npg_LWGS7NyJuc0X@ep-twilight-haze-ayi43kcc-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# Media & Uploads Storage Directory
UPLOADS_DIR=/app/uploads

# Security & Sessions (7 Days Expiry for Campus Dashboard)
SECRET_KEY=your_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudflare R2 Media Storage (Optional: uses local disk cache if placeholder)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=greenpark-school-images

# Frontend API URL (leave blank for dynamic LAN auto-detection)
VITE_API_URL=
